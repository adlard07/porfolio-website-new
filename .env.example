# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored and never committed.

# --- GitHub project integration ---------------------------------------

# Your GitHub username. Used to fetch public repositories for the
# Featured Projects section. Exposed to the browser (NEXT_PUBLIC_*) only
# because it's not sensitive — it's the same username in your profile URL.
# data/portfolio.js already falls back to "adlard07" if this is unset.
NEXT_PUBLIC_GITHUB_USERNAME=adlard07

# Optional. A GitHub personal access token (classic or fine-grained,
# "public_repo" / read-only scope is enough) used server-side only, to
# raise the GitHub API rate limit from 60 to 5,000 requests/hour. Never
# prefix this with NEXT_PUBLIC_ — it must stay server-side.
GITHUB_TOKEN=

# --- Site metadata / SEO ------------------------------------------------

# The canonical production URL of your deployed site, used for
# Open Graph tags, JSON-LD, and the generated sitemap/robots files.
NEXT_PUBLIC_SITE_URL=https://adlard.vercel.app
